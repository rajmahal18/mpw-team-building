DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mpw_team_building?schema=public"
# Development/custom cookie name. In production, only a __Host- prefixed value is accepted; otherwise the app uses __Host-mpw_tb_session.
AUTH_COOKIE_NAME="mpw_tb_session"
AUTH_SESSION_DAYS="7"
SEED_ADMIN_EMAIL="admin@mpw.local"
SEED_ADMIN_PASSWORD="replace-me-before-seeding"
SEED_ADMIN_NAME="MPW Organizer"
QR_SIGNING_SECRET="replace-with-at-least-32-random-bytes"
PARTICIPANT_SESSION_HOURS="24"
MEDIA_MAX_IMAGE_MB="8"
MEDIA_MAX_VIDEO_MB="30"
MEDIA_MAX_AUDIO_MB="15"
MEDIA_MAX_FILE_MB="15"
RATE_LIMIT_SECRET="replace-with-at-least-32-random-bytes"
# Set to the exact deployed HTTPS origin in production.
APP_ORIGIN="http://localhost:3000"
